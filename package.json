{
  "name": "open-mcp-servers-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace containing the Open Work Meta and GitHub MCP packages.",
  "type": "module",
  "workspaces": [
    "packages/meta",
    "packages/github"
  ],
  "scripts": {
    "start": "node packages/meta/dist/index.js",
    "dev": "tsx watch packages/meta/src/index.ts",
    "build": "tsc -b packages/meta packages/github",
    "build:meta": "npm run build --workspace @open-work-org/meta-mcp-server",
    "build:github": "npm run build --workspace @open-work-org/github-mcp-server",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf packages/meta/dist packages/github/dist packages/meta/tsconfig.tsbuildinfo packages/github/tsconfig.tsbuildinfo"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-work-org/open-mcp-servers.git"
  },
  "license": "MIT",
  "author": "Open Work Org",
  "keywords": [
    "mcp",
    "meta",
    "github",
    "connectors",
    "model-context-protocol"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vitest": "^4.1.0"
  }
}
