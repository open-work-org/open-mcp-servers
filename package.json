{
  "name": "@open-work-org/meta-mcp-server",
  "version": "1.0.1",
  "description": "Self-hosted Meta MCP connector with local stdio and remote Streamable HTTP hosting, covering 200 tools across Facebook Pages, Instagram, Threads, Ads Manager, Commerce, and more",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "meta-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-work-org/open-mcp-servers.git"
  },
  "license": "MIT",
  "author": "Open Work Org",
  "keywords": [
    "mcp",
    "meta",
    "facebook",
    "instagram",
    "threads",
    "ads-manager",
    "graph-api",
    "model-context-protocol",
    "streamable-http",
    "claude",
    "ai-tools",
    "self-hosted",
    "open-source",
    "connectors"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.20.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vitest": "^4.1.0"
  }
}
