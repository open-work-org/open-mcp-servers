# Meta credentials
META_ACCESS_TOKEN=replace-with-your-meta-token
THREADS_ACCESS_TOKEN=replace-with-your-threads-token

# Remote MCP server settings
MCP_TRANSPORT=streamable-http
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=3000
MCP_HTTP_PATH=/mcp
MCP_HTTP_AUTH_TOKEN=replace-with-a-long-random-token
# MCP_HTTP_ALLOW_UNAUTHENTICATED=false

# Required only when browser-based clients connect from another origin.
# Use a comma-separated list for multiple origins.
# MCP_HTTP_ALLOWED_ORIGINS=https://your-client.example.com

# Optional Meta API overrides for proxies, testing, or compatible API gateways.
# META_GRAPH_API_BASE_URL=https://graph.facebook.com
# META_GRAPH_API_VERSION=v21.0
# THREADS_API_BASE_URL=https://graph.threads.net
# THREADS_API_VERSION=v1.0
# QUICKCHART_BASE_URL=https://quickchart.io/chart
