{
  "name": "@open-work-org/github-mcp-server",
  "version": "1.0.2",
  "description": "Self-hosted GitHub MCP connector with full PAT-authorized REST, GraphQL, release, tag, asset, and secret tools.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "github-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/",
    "docs/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
