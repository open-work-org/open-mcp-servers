FROM ghcr.io/github/github-mcp-server:latest AS upstream

FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
COPY packages/meta/package.json packages/meta/package.json
COPY packages/github/package.json packages/github/package.json
RUN npm ci

COPY packages/github/tsconfig.json packages/github/tsconfig.json
COPY packages/github/src packages/github/src
RUN npm run build:github
RUN npm prune --omit=dev

FROM node:20-alpine

WORKDIR /app
ENV NODE_ENV=production
ENV MCP_TRANSPORT=streamable-http
ENV MCP_HTTP_HOST=0.0.0.0
ENV GITHUB_MCP_HTTP_PORT=3001
ENV GITHUB_MCP_HTTP_PATH=/github/mcp
ENV OPEN_MCP_GITHUB_UPSTREAM_COMMAND=/usr/local/bin/github-mcp-server
ENV OPEN_MCP_GITHUB_UPSTREAM_ARGS=["stdio"]

COPY --from=upstream /server/github-mcp-server /usr/local/bin/github-mcp-server
COPY --from=build --chown=node:node /app/packages/github/package.json ./package.json
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/packages/github/dist ./dist

USER node
EXPOSE 3001

CMD ["node", "dist/index.js"]
